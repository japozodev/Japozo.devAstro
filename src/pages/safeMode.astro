---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DATA, SOCIAL_LINKS } from "../config";
import VisualCard from "../components/VisualCard.astro";

import HtmlIcon from "../components/icons/HtmlIcon.astro";
import CssIcon from "../components/icons/CssIcon.astro";
import JsIcon from "../components/icons/JsIcon.astro";
import AstroIcon from "../components/icons/AstroIcon.astro";
import WordpressIcon from "../components/icons/WordpressIcon.astro";
import ElementorIcon from "../components/icons/ElementorIcon.astro";
import BootstrapIcon from "../components/icons/BootstrapIcon.astro";
import GitIcon from "../components/icons/GitIcon.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";

// --- LÓGICA / DATOS ---
const year = new Date().getFullYear();

const projects = [
  {
    title: "IP Topografía",
    desc: "Desarrollo de sitio web corporativo para empresa de topografía.",
    statusText: "Online",
    statusClass: "status-deployed",
    url: "https://iptopografia.com",
    external: true,
    i18nDesc: "project-iptopo-desc",
    i18nStatus: "status-online",
  },
  {
    title: "Allianz Partner",
    desc: "Sitio web corporativo para partner de compañía internacional de seguros y activos financieros.",
    statusText: "En Desarrollo",
    statusClass: "status-dev",
    url: "#",
    external: false,
    i18nDesc: "project-allianz-desc",
    i18nStatus: "status-dev",
  },
  {
    title: "R2R Consulting",
    desc: "Desarrollo web para consultoría especializada en servicios inmobiliarios.",
    statusText: "Online",
    statusClass: "status-deployed",
    url: "https://r2r.es/",
    external: true,
    i18nDesc: "project-r2r-desc",
    i18nStatus: "status-online",
  },
];

const skills = [
  { name: "HTML / CSS", pct: "95%" },
  { name: "JavaScript", pct: "85%" },
  { name: "UI / UX Design", pct: "80%" },
  { name: "Teamwork", pct: "75%" },
  { name: "Problem Solving", pct: "85%" },
];

const technologies = [
  { Icon: HtmlIcon, name: "HTML5", innerFill: "#ffffff" },
  { Icon: CssIcon, name: "CSS3", innerFill: "#ffffff" },
  { Icon: JsIcon, name: "JAVASCRIPT", innerFill: "#ffffff" },
  { Icon: AstroIcon, name: "ASTRO" },
  { Icon: WordpressIcon, name: "WORDPRESS" },
  { Icon: ElementorIcon, name: "ELEMENTOR" },
  { Icon: BootstrapIcon, name: "BOOTSTRAP" },
  { Icon: GitIcon, name: "GIT" },
  { Icon: GithubIcon, name: "GITHUB", mobileOnly: true },
];

// Favicon SVG String (Safe Mode Blue)
const faviconSafe =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/><text x='50' y='70' font-size='55' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'>P</text></svg>";
---

<BaseLayout
  title="Pozo — Frontend Developer | Portfolio"
  description="Portfolio de Pozo. Desarrollador Frontend especializado en crear experiencias web únicas. HTML5, CSS3, JS y Diseño UI/UX."
  author="J. A. Pozo"
  themeColor="#ffffff"
  cssFile="/Assets/css/safeMode.css"
  jsFile="/Assets/js/safeMode.js"
  favicon={faviconSafe}
>
  <header>
    <nav>
      <a href="#inicio" class="logo">japozo<span>.dev</span></a>

      <button class="mobile-toggle" aria-label="Abrir menú">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>

      <div class="nav-links">
        <a href="#proyectos" data-i18n="nav-projects">Proyectos</a>
        <a href="#user-profile" data-i18n="nav-profile">Perfil</a>
        <a href="#contacto" data-i18n="nav-contact">Contacto</a>
        <button
          id="lang-toggle"
          class="lang-toggle"
          aria-label="Switch language">EN</button
        >
        <a href="/" class="switch-mode">&gt;_ TERMINAL_MODE</a>
      </div>
    </nav>
  </header>

  <section id="inicio">
    <div class="section-intro" data-i18n="intro-label">Frontend Developer</div>
    <h1><span data-i18n="intro-heading">Hola, soy </span><span>Pozo</span></h1>
    <p class="subtitle" data-i18n="intro-sub">
      Desarrollo experiencias web que combinan innovación, funcionalidad y buen
      diseño.<br />
      Traduzco ideas en código claro, mantenible y orientado a resultados.
    </p>

    <h2 data-i18n="tech-heading">Tecnologías Principales</h2>
    <div class="tech-grid">
      {
        technologies.map((tech) => (
          <div class={`tech-item ${tech.mobileOnly ? "mobile-only" : ""}`}>
            <tech.Icon class="tech-icon" innerFill={tech.innerFill} />
            <span>{tech.name}</span>
          </div>
        ))
      }
    </div>

    <a href="#proyectos" class="btn" data-i18n="btn-projects">Ver Proyectos</a>
  </section>

  <section id="proyectos">
    <h2 data-i18n="projects-heading">Proyectos Destacados</h2>
    <div class="grid">
      {projects.map((project) => <VisualCard project={project} />)}
    </div>
  </section>

  <section id="user-profile">
    <h2 data-i18n="profile-heading">Sobre Mí</h2>

    <div class="profile-container">
      <div class="profile-sidebar">
        <div class="profile-ring-wrapper">
          <img
            src="/Assets/img/profile.jpg"
            alt="Foto de perfil"
            class="profile-avatar"
          />

          <svg class="ring-svg" viewBox="0 0 216 216">
            <circle class="ring-bg" cx="108" cy="108" r="104"></circle>
            <circle class="ring-anim" cx="108" cy="108" r="104"></circle>
          </svg>
        </div>

        <div style="margin-top: 1rem;">
          <p>
            <span class="label" data-i18n="label-location">Ubicación:</span>
            <span data-i18n="value-location">Gijón, España</span>
          </p>
          <p>
            <span class="label" data-i18n="label-role">Rol:</span>
            <span data-i18n="value-role">Web Developer</span>
          </p>
          <p>
            <span class="label" data-i18n="label-status">Estado:</span>
            <span data-i18n="value-status">Desarrollando en @Kewo</span>
          </p>
        </div>
      </div>

      <div class="profile-info">
        <div class="bio-box">
          <h3 data-i18n="bio-heading">Biografía Profesional</h3>
          <p class="bio-text" data-i18n="bio-text">
            Apasionado por la tecnología desde niño, he pasado más de 20 años
            trabajando con hardware. Tras ese recorrido decidí dar un giro
            profesional para centrarme en lo que realmente me motiva: el
            desarrollo web y de software. Hoy diseño y construyo soluciones
            digitales con identidad propia, cuidando tanto la eficiencia del
            código como la experiencia final.
          </p>
        </div><br />

        <div class="skills-box">
          <h3 data-i18n="skills-heading">Habilidades Técnicas</h3>
          {
            skills.map((skill) => (
              <div class="skill-row">
                <div class="skill-info">
                  <>
                    <span>{skill.name}</span>
                    <span>{skill.pct}</span>
                  </>
                </div>
                <div class="progress-bg">
                  <div
                    class="progress-fill progress-initial"
                    data-width={skill.pct}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="contacto">
    <h2 data-i18n="contact-heading">Contacto</h2>
    <p class="contact-intro"></p>

    <div class="network-panel">
      <div class="data-row">
        <span class="label" data-i18n="label-email">Email:</span>
        <a id="email-link" href="#" class="value-link">[...]</a>
      </div>
      <div class="data-row">
        <span class="label" data-i18n="label-social">Redes Sociales:</span>
        <div class="social-links">
          <a href={SOCIAL_LINKS.github} target="_blank">GitHub</a>
          <a href={SOCIAL_LINKS.linkedin} target="_blank">LinkedIn</a>
        </div>
      </div>
    </div>

    <div class="contact-section">
      <button
        id="copy-btn"
        class="btn copy-email-btn"
        data-i18n="btn-copy-email"
      >
        Copiar Email al Portapapeles
      </button>
    </div>
  </section>

  <footer>
    <p>&copy; <span id="year">{year}</span> J. A. Pozo</p>
  </footer>
  <!-- Cargamos i18n.js con los idiomas -->
  <script src="/Assets/js/i18n.js" is:inline></script>
</BaseLayout>
