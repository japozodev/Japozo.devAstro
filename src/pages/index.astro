---
// 1. IMPORTAR COMPONENTES
import AsciiArt from '../components/AsciiArt.astro';
// 2. IMPORTAR ESTILOS
import '/public/Assets/css/styles.css';
// 3. IMPORTACIONES DE ICONOS
import HtmlIcon from '../components/icons/HtmlIcon.astro';
import CssIcon from '../components/icons/CssIcon.astro';
import JsIcon from '../components/icons/JsIcon.astro';
import AstroIcon from '../components/icons/AstroIcon.astro';
import WordpressIcon from '../components/icons/WordpressIcon.astro';
import ElementorIcon from '../components/icons/ElementorIcon.astro';
import BootstrapIcon from '../components/icons/BootstrapIcon.astro';
import GitIcon from '../components/icons/GitIcon.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';
---

<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050505">
  <meta name="color-scheme" content="dark">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="msapplication-navbutton-color" content="#050505"> 
  <meta name="description"
    content="Portfolio de Pozo. Desarrollador Frontend especializado en crear experiencias web únicas. HTML5, CSS3, JS y Diseño UI/UX.">
  <meta name="author" content="J. A. Pozo">
  <link rel="canonical" href="https://japozo.dev/">

  <meta property="og:type" content="website">
  <meta property="og:url" content="https://japozo.dev/">
  <meta property="og:title" content="Pozo — Frontend Developer | Portfolio">
  <meta property="og:description"
    content="Desarrollador Frontend. Experiencias web disruptivas en modo Terminal y Visual.">
  <meta property="og:image" content="https://japozo.dev/Assets/img/social-preview.jpg">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://japozo.dev/">
  <meta name="twitter:title" content="Pozo — Frontend Developer">
  <meta name="twitter:description" content="Desarrollador Frontend. Echa un vistazo a mis proyectos.">
  <meta name="twitter:image" content="https://japozo.dev/Assets/img/social-preview.jpg">

  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23050505'/><text x='50' y='70' font-size='55' text-anchor='middle' fill='%2333ff33' font-family='monospace' font-weight='bold'>P&gt;</text></svg>">
  <title>Pozo — Frontend Developer | Creative Web Interfaces</title>
 
  <script is:inline src="/Assets/js/script.js"></script>
</head>

<body>

  <div id="boot-screen">
    <div id="boot-text"></div>
  </div>

  <div class="crt-overlay"></div>
  <div class="scanline"></div>

  <header>
    <nav>
      <a href="#inicio" class="logo logo-link">&gt;<span
          class="blink">_</span> SYSTEM.ROOT</a>

      <div class="mobile-toggle" id="mobile-menu-btn">[ :: MENU :: ]</div>

      <div class="nav-links" id="nav-links">
        <a href="#proyectos">[ PROJECTS ]</a>
        <a href="#user-profile">[ USER_PROFILE ]</a>
        <a href="#contacto">[ CONNECTION ]</a>
        <a href="safeMode.html" class="safe-mode-btn">[ SAFE_MODE ]</a>
      </div>
    </nav>
  </header>

  <section id="inicio">
    <p id="linea1" class="output-text"></p>

    <h1 id="main-title" class="main-title"></h1>

    <p id="linea2" class="secondary-text"></p>
    <h2>./CORE_STACK</h2>
    <div class="tech-grid">
      <div class="tech-item">
        <HtmlIcon class="tech-icon" />
        <span>HTML5</span>
      </div>

      <div class="tech-item">
        <CssIcon class="tech-icon" />
        <span>CSS3</span>
      </div>

      <div class="tech-item">
       <JsIcon class="tech-icon" />
        <span>JAVASCRIPT</span>
      </div>

      <div class="tech-item">
        <AstroIcon class="tech-icon" />
        <span>ASTRO</span>
      </div>

      <div class="tech-item">
       <WordpressIcon class="tech-icon" />
        <span>WORDPRESS</span>
      </div>

      <div class="tech-item">
       <ElementorIcon class="tech-icon" />
        <span>ELEMENTOR</span>
      </div>
      <div class="tech-item">
        <BootstrapIcon class="tech-icon" />
        <span>BOOTSTRAP</span>
      </div>
      <div class="tech-item">
        <GitIcon class="tech-icon" />
        <span>GIT</span>
      </div>
      <div class="tech-item mobile-only">
        <GithubIcon class="tech-icon" />
        <span>GITHUB</span>
      </div>
    </div>
    <a href="#proyectos" class="btn">EXEC Portfolio.exe</a>
  </section>

  <section id="proyectos">
    <h2>./Projects</h2>
    <div class="grid">

      <a href="https://iptopografia.com" class="card" target="_blank" rel="noopener noreferrer">
        <h3>[ PROJECT_ALPHA ]</h3>
        <h4>[ IPTOPOGRAFIA ]</h4><br>
        <p>Corporate website for land surveying<br>STATUS: 200 OK <span class="blink">ONLINE</span></p>
      </a>

      <a href="#" class="card">
        <h3>[ PROJECT_BETA ]</h3>
        <h4>[ ALLIANZ PARTNER ]</h4><br>
        <p>Global insurance and asset management<br>STATUS: 503 <br><span class="blink status-warning">SERVICE
            UNAVAILABLE IN_DEV</span></p>

      </a>

      <a href="https://r2r.es/" class="card" target="_blank" rel="noopener noreferrer">
        <h3>[ PROJECT_GAMMA ]</h3>
        <h4>[ R2R CONSULTING ]</h4><br>
        <p>End-to-end solutions for property services<br>STATUS: 200 OK <span class="blink">ONLINE</span></p>
      </a>

    </div>
    <a href="#contacto" class="btn">INIT CONTACT PROTOCOL</a>
  </section>

  <section id="user-profile" class="section">
    <h2>./User_Profile</h2>

    <div class="profile-container">

      <div class="profile-sidebar">
        <AsciiArt />
        <div class="status-badge">
          <span class="blink">●</span> STATUS: ONLINE
        </div>
      </div>

      <div class="profile-info">

        <div class="bio-box">
          <h3>&gt;&gt; IDENTITY_LOG</h3>
          <p>
            <span class="label">ID_NAME:</span> J.A. Pozo<br>
            <span class="label">LOCATION:</span> Gijón / Spain<br>
            <span class="label">CLASS:</span> Web Developer<br>
            <span class="label">LVL:</span><span id="user-age">CALCULATING...</span>Y
          </p>
          <p class="bio-text">
            I’ve been passionate about technology since I was a kid. After 20 years working with hardware, I decided to
            change direction and focus on what truly motivates me: development. Since then, I’ve been constantly working
            on new designs and solutions that push my work further and make it distinctive.
          </p>
        </div>

        <div class="skills-box">
          <h3>&gt;&gt; SKILL_MATRIX</h3>

          <div class="skill-row">
            <span class="skill-name">HTML / CSS</span>
            <span class="skill-bar">[||||||||||||||<span class="blink-magenta">|</span>-] 95%</span>
          </div>

          <div class="skill-row">
            <span class="skill-name">JavaScript</span>
            <span class="skill-bar">[|||||||||||||<span class="blink-magenta">|</span>--] 85%</span>
          </div>

          <div class="skill-row">
            <span class="skill-name">UI / UX Design</span>
            <span class="skill-bar">[||||||||||||<span class="blink-magenta">|</span>---] 80%</span>
          </div>

          <div class="skill-row">
            <span class="skill-name"> Teamwork</span>
            <span class="skill-bar">[|||||||||||<span class="blink-magenta">|</span>----] 75%</span>
          </div>

          <div class="skill-row">
            <span class="skill-name">Problem Solving</span>
            <span class="skill-bar">[|||||||||||||<span class="blink-magenta">|</span>--] 85%</span>
          </div>

        </div>

      </div>
    </div>
  </section>

  <section id="contacto">
    <h2>./Connection</h2>
    <p>Establishing P2P connection...</p>

    <div class="network-panel">
      <div class="data-row">
        <span class="label">PROTOCOL:</span>
        <span class="value">SMTP (Email)</span>
      </div>
      <div class="data-row">
        <span class="label">ADDRESS:</span>
        <a href="mailto:contact@japozo.dev" class="value-link">contact@japozo.dev</a>
      </div>
      <div class="data-row">
        <span class="label">LOCATION:</span>
        <span class="value">Remote / Spain</span>
      </div>
      <div class="data-row">
        <span class="label">SOCIAL_NET:</span>
        <div class="social-links">
          <a href="https://github.com/japozodev" target="_blank">[ GITHUB ]</a>
          <a href="https://www.linkedin.com/in/joseantoniopozogonzalez/" target="_blank">[ LINKEDIN ]</a>
        </div>
      </div>
    </div>

    <div style="margin-top: 2rem;">
      <p>&gt;_ Execute copy command:</p>
      <button id="copy-btn" class="btn">
        $ cp email_address /clipboard
      </button>
    </div>
  </section>

  <footer>
    <p>STATUS: ONLINE | SYSTEM V.0.9 | SESSION_ID: $USERX0042-<span id="year">20XX</span>-XF ©</p>
  </footer>
</body>

</html>