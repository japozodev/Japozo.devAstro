---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiArt from '../components/AsciiArt.astro';
import { SITE_DATA, SOCIAL_LINKS } from '../config';
import TerminalCard from '../components/TerminalCard.astro';

// Iconos
import HtmlIcon from '../components/icons/HtmlIcon.astro';
import CssIcon from '../components/icons/CssIcon.astro';
import JsIcon from '../components/icons/JsIcon.astro';
import AstroIcon from '../components/icons/AstroIcon.astro';
import WordpressIcon from '../components/icons/WordpressIcon.astro';
import ElementorIcon from '../components/icons/ElementorIcon.astro';
import BootstrapIcon from '../components/icons/BootstrapIcon.astro';
import GitIcon from '../components/icons/GitIcon.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';

// --- LÓGICA / DATOS ---
const year = new Date().getFullYear();

const projects = [
  {
    id: "ALPHA",
    name: "IPTOPOGRAFIA",
    desc: "Corporate website for land surveying",
    status: "ONLINE",
    statusCode: "200 OK",
    url: "https://iptopografia.com",
    active: true
  },
  {
    id: "BETA",
    name: "ALLIANZ PARTNER",
    desc: "Global insurance and asset management",
    status: "ONLINE",
    statusCode: "200 OK",
    url: "https://www.pedroalegre.es/",
    active: true
  },
  {
    id: "GAMMA",
    name: "R2R CONSULTING",
    desc: "End-to-end solutions for property services",
    status: "ONLINE",
    statusCode: "200 OK",
    url: "https://r2r.es/",
    active: true
  },
  {
    id: "DELTA",
    name: "TRES OSCOS",
    desc: "Product showcase for business",
    status: "ONLINE",
    statusCode: "200 OK",
    url: "https://tresoscos.kewo.dev/",
    active: true
  }
];

const skills = [
  { name: "HTML / CSS",      bar: "[||||||||||||||", blink: "|", end: "-] 95%" },
  { name: "JavaScript",      bar: "[|||||||||||||",  blink: "|", end: "--] 85%" },
  { name: "UI / UX Design",  bar: "[||||||||||||",   blink: "|", end: "---] 80%" },
  { name: "Teamwork",        bar: "[|||||||||||",    blink: "|", end: "----] 75%" },
  { name: "Problem Solving", bar: "[|||||||||||||",  blink: "|", end: "--] 85%" },
];

const technologies = [
  { Icon: HtmlIcon,       name: "HTML5" },
  { Icon: CssIcon,        name: "CSS3" },
  { Icon: JsIcon,         name: "JAVASCRIPT" },
  { Icon: AstroIcon,      name: "ASTRO" },
  { Icon: WordpressIcon,  name: "WORDPRESS" },
  { Icon: ElementorIcon,  name: "ELEMENTOR" },
  { Icon: BootstrapIcon,  name: "BOOTSTRAP" },
  { Icon: GitIcon,        name: "GIT" },
  { Icon: GithubIcon,     name: "GITHUB",     mobileOnly: true },
];

// Favicon SVG String (Terminal Green)
const faviconTerminal = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23050505'/><text x='50' y='70' font-size='55' text-anchor='middle' fill='%2333ff33' font-family='monospace' font-weight='bold'>P&gt;</text></svg>";
---

<BaseLayout
  title="Pozo — Frontend Developer | Creative Web Interfaces"
  description="Portfolio de Pozo. Desarrollador Frontend especializado en crear experiencias web únicas. HTML5, CSS3, JS y Diseño UI/UX."
  author="J. A. Pozo"
  themeColor="#050505"
  cssFile="/Assets/css/styles.css"
  jsFile="/Assets/js/script.js"
  favicon={faviconTerminal}
>
  <fragment slot="head-extra">
    <meta name="color-scheme" content="dark">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="msapplication-navbutton-color" content="#050505">
  </fragment>

  <div id="boot-screen">
    <div id="boot-text"></div>
  </div>

  <div class="crt-overlay"></div>
  <div class="scanline"></div>

  <header>
    <nav>
      <a href="#inicio" class="logo logo-link">&gt;<span class="blink">_</span> SYSTEM.ROOT</a>
      <div class="mobile-toggle" id="mobile-menu-btn">[ :: MENU :: ]</div>
      <div class="nav-links" id="nav-links">
        <a href="#proyectos">[ PROJECTS ]</a>
        <a href="#user-profile">[ USER_PROFILE ]</a>
        <a href="#contacto">[ CONNECTION ]</a>
        <a href="/safeMode" class="safe-mode-btn">[ SAFE_MODE ]</a>
      </div>
    </nav>
  </header>

  <section id="inicio">
    <p id="linea1" class="output-text"></p>
    <h1 id="main-title" class="main-title"></h1>
    <p id="linea2" class="secondary-text"></p>
    
    <h2>./CORE_STACK</h2>
    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class={`tech-item ${tech.mobileOnly ? "mobile-only" : ""}`}>
          <tech.Icon class="tech-icon" />
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
    
    <a href="#proyectos" class="btn">EXEC Portfolio.exe</a>
  </section>

  <section id="proyectos">
  <h2>./Projects</h2>
  <div class="grid">

    {projects.map((project) => (
      <TerminalCard project={project} />
    ))}

  </div>
  <a href="#contacto" class="btn">INIT CONTACT PROTOCOL</a>
</section>

  <section id="user-profile" class="section">
    <h2>./User_Profile</h2>
    <div class="profile-container">
      <div class="profile-sidebar">
        <AsciiArt />
        <div class="status-badge">
          <span class="blink">●</span> STATUS: ONLINE
        </div>
      </div>

      <div class="profile-info">
        <div class="bio-box">
          <h3>&gt;&gt; IDENTITY_LOG</h3>
          <p>
            <span class="label">ID_NAME:</span> J.A. Pozo<br>
            <span class="label">LOCATION:</span> Gijón / Spain<br>
            <span class="label">CLASS:</span> Web Developer<br>
            <span class="label">STATUS:</span> Developing at @Kewo<br>
            <span class="label">LVL:</span><span id="user-age">CALCULATING...</span>Y
          </p>
          <p class="bio-text">
            I’ve been passionate about technology since I was a kid. After 20 years working with hardware, I decided to
            change direction and focus on what truly motivates me: development. Since then, I’ve been constantly working
            on new designs and solutions that push my work further and make it distinctive.
          </p>
        </div>

        <div class="skills-box">
          <h3>&gt;&gt; SKILL_MATRIX</h3>
          {skills.map((skill) => (
            <div class="skill-row">
              <span class="skill-name">{skill.name}</span>
              <span class="skill-bar">{skill.bar}<span class="blink-magenta">{skill.blink}</span>{skill.end}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="contacto">
    <h2>./Connection</h2>
    <p>Establishing P2P connection...</p>
    <div class="network-panel">
      <div class="data-row">
        <span class="label">PROTOCOL:</span>
        <span class="value">SMTP (Email)</span>
      </div>
      <div class="data-row">
        <span class="label">ADDRESS:</span>
        <a id="email-link" href="#" class="value-link" data-email-b64={SITE_DATA.email}>[ Click to reveal ]</a>
      </div>
      <div class="data-row">
        <span class="label">LOCATION:</span>
        <span class="value">Remote / Spain</span>
      </div>
      <div class="data-row">
        <span class="label">SOCIAL_NET:</span>
        <div class="social-links">
          <a href={SOCIAL_LINKS.github} target="_blank">[ GITHUB ]</a>
          <a href={SOCIAL_LINKS.linkedin} target="_blank">[ LINKEDIN ]</a>
        </div>
      </div>
    </div>

    <div style="margin-top: 2rem;">
      <p>&gt;_ Execute copy command:</p>
      <button
        id="copy-btn"
        class="btn"
      >
        $ cp email_address /clipboard
      </button>
    </div>
  </section>

  <footer>
    <p>STATUS: ONLINE | SYSTEM V.0.9 | SESSION_ID: $USERX0042-<span id="year">{year}</span>-XF ©</p>
  </footer>
</BaseLayout>