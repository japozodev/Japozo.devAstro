---
import { SITE_DATA } from '../config';

interface Props {
  title: string;
  description: string;
  author: string;
  themeColor: string;
  cssFile: string;
  jsFile: string;
  favicon: string;
  canonicalURL?: string;
}

const { 
  title = SITE_DATA.title, 
  description = SITE_DATA.description, 
  author = SITE_DATA.author, 
  themeColor, 
  cssFile, 
  jsFile, 
  favicon,
  canonicalURL = "https://japozo.dev/"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content={themeColor}>
  
  <meta name="description" content={description}>
  <meta name="author" content={author}>
  <link rel="canonical" href={canonicalURL}>

  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://japozo.dev/Assets/img/social-preview.jpg">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content="Pozo — Frontend Developer">
  <meta name="twitter:description" content="Desarrollador Frontend. Echa un vistazo a mis proyectos.">
  <meta name="twitter:image" content="https://japozo.dev/Assets/img/social-preview.jpg">

  <link rel="icon" type="image/svg+xml" href={favicon}>

  <slot name="head-extra" />

  <title>{title}</title>
  
  <link rel="stylesheet" href={cssFile}>
</head>

<body>
  
  <slot />

  <script is:inline src={jsFile}></script>
</body>
</html>